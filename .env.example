# ─────────────────────────────────────────────────────────────
# Environment variable TEMPLATE.
# Copy this file to ".env" and fill in real values. Do NOT commit ".env".
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# --- Supabase: CLIENT (browser) ---
# Safe to expose. Used only for Supabase Auth (sign up / sign in).
# Vite requires the VITE_ prefix to expose a variable to the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# --- Supabase: SERVER (Express backend) ---
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# SECRET key (new-style, == service_role). Bypasses row-level security.
# NEVER expose to the browser. Dashboard → Project Settings → API keys → Secret keys.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# (Optional) Direct Postgres connection string, used ONLY by the migration script.
# Dashboard → Project Settings → Database → Connection string → URI.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.YOUR-PROJECT-ref.supabase.co:5432/postgres

# --- Access provider webhook (turnstile / entry hardware) ---
# Shared HMAC secret used to sign & verify /api/access/events requests.
# In production this is configured in your access-control provider.
ACCESS_WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- Google Gemini (server-side only) ---
# Create one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Pick a model your key supports (list: GET .../v1beta/models). gemini-flash-lite-latest
# is a good stable default; gemini-2.0-flash may be unavailable on some free-tier keys.
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_EMBED_MODEL=gemini-embedding-001

# --- App ---
PORT=3001
NODE_ENV=development
