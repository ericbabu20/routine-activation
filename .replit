run = "npm run start"
entrypoint = "server/index.js"
modules = ["nodejs-20"]

hidden = [".config", "package-lock.json", "dist"]

[nix]
channel = "stable-24_05"

[env]
NODE_ENV = "production"
PORT = "3001"

[deployment]
run = ["sh", "-c", "npm run start"]
build = ["sh", "-c", "npm install && npm run build"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 3001
externalPort = 80
